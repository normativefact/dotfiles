#!/usr/bin/env python3
import base64
import contextlib
import io
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(os.environ.get('TRANSCRIPT_ROOT', Path(__file__).resolve().parent.parent)).expanduser().resolve()
VIDEO_ROOT = Path(os.environ.get('VIDEO_ROOT', Path.home() / 'ics-video-original')).expanduser().resolve()
SCRIPT = shlex.join([sys.executable, str(Path(__file__).resolve())])
EXCLUDES = ['excerpts/**', 'ledger_tools/**', 'research_index*/**', 'vidinspector/**']
REGEX_HELP = r'PCRE2: pattern or /pattern/gimsux | lookarounds, backreferences, \n | bare patterns: smart case'
EDIT_BINDINGS = 'ctrl-k:kill-line,ctrl-y:yank,ctrl-u:unix-line-discard,ctrl-w:unix-word-rubout,ctrl-a:beginning-of-line,ctrl-e:end-of-line,ctrl-b:backward-char,ctrl-f:forward-char,alt-b:backward-word,alt-f:forward-word,alt-d:kill-word,alt-backspace:backward-kill-word,ctrl-n:down,ctrl-p:up,alt-<:first,alt->:last'
COMMANDS = [
    ('regex', 'C-t', 'Search transcripts with PCRE2'),
    ('literal', 'C-l', 'Search transcripts as literal text'),
    ('concepts', 'C-r', 'Fuzzy search indexed concepts'),
    ('directories', 'M-s', 'Choose search directories (multiple allowed)'),
    ('all-directories', '', 'Search all directories'),
    ('open', 'RET', 'Open selected timestamp in MPV'),
    ('open-with', 'C-o', 'Choose a player for the selected timestamp'),
    ('toggle-preview', 'M-v', 'Show or hide transcript preview'),
    ('preview-page-up', 'M-p', 'Scroll transcript preview up'),
    ('preview-page-down', 'M-n', 'Scroll transcript preview down'),
    ('help', 'C-h', 'Show searchable key reference'),
    ('quit', 'C-g / Esc', 'Quit'),
    ('kill-line', 'C-k', 'Kill query from cursor to end'),
    ('yank', 'C-y', 'Yank killed query text'),
    ('unix-line-discard', 'C-u', 'Kill query from cursor to beginning'),
    ('unix-word-rubout', 'C-w', 'Kill preceding whitespace-delimited word'),
    ('backward-kill-word', 'M-DEL', 'Kill preceding word'),
    ('kill-word', 'M-d', 'Kill following word'),
    ('beginning-of-line', 'C-a', 'Move to beginning of query'),
    ('end-of-line', 'C-e', 'Move to end of query'),
    ('backward-char', 'C-b', 'Move backward a character'),
    ('forward-char', 'C-f', 'Move forward a character'),
    ('backward-word', 'M-b', 'Move backward a word'),
    ('forward-word', 'M-f', 'Move forward a word'),
    ('up', 'C-p', 'Previous result'),
    ('down', 'C-n', 'Next result'),
    ('first', 'M-<', 'First result'),
    ('last', 'M->', 'Last result'),
